rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Coach profiles
    match /coaches/{coachId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(coachId);
    }

    // Coach Availability
    match /availability/{coachId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(coachId);
    }

    // Academies
    match /academies/{academyId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(academyId);
    }

    // Players
    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == playerId || request.resource.data.parentId == request.auth.uid);
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email.matches('.*@(krico\\.app|krico\\.pune|sportseco\\.com)$')
      );
    }

    // Venues
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /bookings/{bookingId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Training Sessions
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.coachId ||
        request.auth.uid == resource.data.playerId ||
        request.auth.uid == resource.data.bookedBy ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.coachId ||
        request.auth.uid == resource.data.playerId ||
        request.auth.uid == resource.data.bookedBy ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.coachId ||
        request.auth.uid == resource.data.bookedBy ||
        isAdmin()
      );
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.playerId == request.auth.uid || isAdmin());
    }

    // Follows
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.followerId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.followerId;
      allow update: if false;
    }

    // Chats and messaging
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participants);
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Contracts
    match /contracts/{contractId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.partyAId ||
        request.auth.uid == resource.data.partyBId ||
        isAdmin()
      );
    }

    // Batches
    match /batches/{batchId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (resource == null || request.auth.uid == resource.data.academyId || isAdmin());
    }

    // Academy Placements & Jobs
    match /academyPlacements/{placementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (resource == null || request.auth.uid == resource.data.academyId || isAdmin());
    }
    match /academyInvitations/{inviteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.academyId ||
        request.auth.uid == resource.data.coachId ||
        isAdmin()
      );
    }

    // Performance & Metrics
    match /playerMetrics/{metricId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.playerId ||
        request.auth.uid == resource.data.coachId ||
        isAdmin()
      );
    }
    match /studentProgress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.coachId ||
        isAdmin()
      );
    }

    // Video Analysis
    match /videoAnalysis/{videoId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.playerId ||
        request.auth.uid == resource.data.coachId ||
        isAdmin()
      );
    }

    // Squad Goals & Challenges
    match /squadGoals/{goalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /playerAchievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.playerId ||
        isAdmin()
      );
    }

    // Community Posts & Comments
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid == resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Pilot In-App Feedback & User Reports
    match /pilotFeedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}