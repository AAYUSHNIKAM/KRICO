rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.isAdmin == true);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /coaches/{coachId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == coachId;
    }
    match /academies/{academyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == academyId;
    }
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /venues/{venueId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    match /contracts/{contractId} {
      allow read, write: if request.auth != null && (request.auth.uid == resource.data.partyAId || request.auth.uid == resource.data.partyBId);
    }
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }
    match /batches/{batchId} {
      allow read, write: if request.auth != null;
    }
    match /coupons/{couponId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /academyPlacements/{placementId} {
      allow read, write: if request.auth != null;
    }
    match /playerMetrics/{metricId} {
      allow read, write: if request.auth != null;
    }
    match /videoAnalysis/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.playerId;
    }
    match /squadGoals/{goalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /playerAchievements/{achievementId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
