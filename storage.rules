rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos (max 5MB, image only)
    match /profile_photos/{userId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Training videos for AI review (max 100MB, video only)
    match /videos/{playerId}/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == playerId &&
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
    }

    // Chat attachments (max 10MB, image/video)
    match /chat/{chatId}/{senderId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == senderId &&
        request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // Community posts media (images up to 10MB, videos up to 50MB)
    match /community_posts/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 50 * 1024 * 1024;
    }

    // Deny all other unmatched paths by default
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
